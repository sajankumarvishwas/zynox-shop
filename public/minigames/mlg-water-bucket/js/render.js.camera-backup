import { WORLD } from "./config.js";

const PALETTE = {
  skyTop:"#1c2116", skyBottom:"#10120c", cloud:"rgba(245,241,223,0.10)",
  farHill:"#20281a", midHill:"#283420", grass:"#3b9d2b", grassEdge:"#55d63f",
  dirt:"#5a4326", zoneSafe:"rgba(85,214,63,0.28)", zoneEdge:"#55d63f",
  water:"#4fa8ff", waterLight:"#8fd3ff", ghost:"rgba(245,241,223,0.28)",
  impact:"#dce9a5", bucketFallback:"#aeb6be", fallGlow:"rgba(141,211,255,0.28)"
};

export class Renderer {
  constructor(canvas){
    this.canvas=canvas; this.ctx=canvas.getContext("2d"); this.animTime=0;
    this.landingFx=[]; this.waterFx=[];
    this.clouds=Array.from({length:5},(_,i)=>({x:(i/5)*WORLD.width+Math.random()*60,y:40+Math.random()*120,w:60+Math.random()*50,speed:4+Math.random()*6}));
    this.playerImage=new Image(); this.playerImageLoaded=false;
    this.playerImage.onload=()=>{this.playerImageLoaded=true}; this.playerImage.src="/assets/characters/player/player_idle.png";
    this.bucketImage=new Image(); this.bucketImageLoaded=false;
    this.bucketImage.onload=()=>{this.bucketImageLoaded=true}; this.bucketImage.src="/assets/minecraft/items/bucket.png";
  }
  resize(displayWidth,displayHeight){const dpr=Math.min(window.devicePixelRatio||1,2);this.canvas.width=Math.round(displayWidth*dpr);this.canvas.height=Math.round(displayHeight*dpr);this.canvas.style.width=`${displayWidth}px`;this.canvas.style.height=`${displayHeight}px`;this.scale=this.canvas.width/WORLD.width;this.ctx.setTransform(this.scale,0,0,this.scale,0,0)}
  updateClouds(dt){this.animTime+=dt;for(const c of this.clouds){c.x+=c.speed*dt;if(c.x>WORLD.width+80)c.x=-80}for(const fx of this.landingFx)fx.age+=dt;this.landingFx=this.landingFx.filter(f=>f.age<f.life);for(const fx of this.waterFx)fx.age+=dt;this.waterFx=this.waterFx.filter(f=>f.age<f.life)}
  triggerLandingImpact(x,y,grade="GOOD"){const power=grade==="PERFECT MLG"?1.35:grade==="MLG"?1.15:1;this.landingFx.push({x,y,age:0,life:.55,power});this.waterFx.push({x,y,age:0,life:.75,power})}
  triggerWaterPlace(x,y){this.waterFx.push({x,y,age:0,life:.62,power:.82})}
  clear(){this.ctx.clearRect(0,0,WORLD.width,WORLD.height)}
  drawBackground(darkDrop){const ctx=this.ctx,g=ctx.createLinearGradient(0,0,0,WORLD.height);g.addColorStop(0,PALETTE.skyTop);g.addColorStop(1,PALETTE.skyBottom);ctx.fillStyle=g;ctx.fillRect(0,0,WORLD.width,WORLD.height);ctx.fillStyle=PALETTE.cloud;for(const c of this.clouds){ctx.fillRect(c.x,c.y,c.w,14);ctx.fillRect(c.x+10,c.y-8,c.w*.6,12)}ctx.fillStyle=PALETTE.farHill;ctx.fillRect(0,WORLD.height-220,WORLD.width,60);ctx.fillStyle=PALETTE.midHill;ctx.fillRect(0,WORLD.height-170,WORLD.width,50);if(darkDrop){ctx.fillStyle="rgba(0,0,0,.55)";ctx.fillRect(0,0,WORLD.width,WORLD.height)}}
  drawGround(groundY){const ctx=this.ctx;ctx.fillStyle=PALETTE.dirt;ctx.fillRect(0,groundY+10,WORLD.width,WORLD.height-groundY-10);ctx.fillStyle=PALETTE.grass;ctx.fillRect(0,groundY,WORLD.width,12);ctx.fillStyle=PALETTE.grassEdge;ctx.fillRect(0,groundY,WORLD.width,3);ctx.fillStyle="rgba(255,255,255,.035)";for(let x=0;x<WORLD.width;x+=28)ctx.fillRect(x+3,groundY+14,12,3)}
  drawLandingZone(zoneCenterX,zoneHalfWidth,groundY){const ctx=this.ctx,left=zoneCenterX-zoneHalfWidth,p=.78+Math.sin(this.animTime*5)*.12;ctx.save();ctx.globalAlpha=p;ctx.fillStyle=PALETTE.zoneSafe;ctx.fillRect(left,groundY-4,zoneHalfWidth*2,8);ctx.strokeStyle=PALETTE.zoneEdge;ctx.lineWidth=2;ctx.strokeRect(left,groundY-4,zoneHalfWidth*2,8);ctx.globalAlpha=.3;ctx.fillStyle=PALETTE.zoneEdge;ctx.fillRect(zoneCenterX-2,groundY-12,4,24);ctx.restore()}
  drawWater(x,groundY,progress){const ctx=this.ctx,reveal=Math.min(1,Math.max(0,progress*1.75)),width=58*reveal,height=14+Math.sin(this.animTime*12)*1.2;ctx.save();ctx.fillStyle=PALETTE.water;ctx.fillRect(x-width/2,groundY-height,width,height);ctx.fillStyle=PALETTE.waterLight;ctx.fillRect(x-width/2,groundY-height,width,3);ctx.globalAlpha=.45+reveal*.35;ctx.fillRect(x-width/2+4,groundY-height+5,Math.max(0,width-8),2);ctx.restore();this._drawWaterRipples()}
  _drawWaterRipples(){const ctx=this.ctx;for(const fx of this.waterFx){const t=fx.age/fx.life;if(t<0||t>1)continue;const r=8+t*38*fx.power;ctx.save();ctx.globalAlpha=(1-t)*.75;ctx.strokeStyle=PALETTE.waterLight;ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(fx.x,fx.y-2,r,4+r*.12,0,0,Math.PI*2);ctx.stroke();if(t<.55){ctx.globalAlpha=(1-t/.55)*.45;ctx.fillStyle=PALETTE.waterLight;ctx.fillRect(fx.x-2,fx.y-18-t*12,4,4)}ctx.restore()}}
  drawPlayer(player,cosmeticColor,hasWater){const ctx=this.ctx,{x,y,width,height}=player;const fallingFast=player.velocityY>300,speedRatio=Math.min(1,Math.abs(player.velocityY)/1250),bob=Math.sin(this.animTime*9)*.7,lean=Math.max(-.24,Math.min(.24,player.velocityX*.0008)),stretch=1+speedRatio*.08,squash=1-speedRatio*.05;ctx.save();ctx.translate(x,y+bob);ctx.rotate(lean);ctx.scale(player.facing<0?-1:1,1);if(fallingFast){ctx.save();ctx.globalAlpha=.16+speedRatio*.1;ctx.fillStyle=PALETTE.fallGlow;ctx.fillRect(-width*.7,-height*.25,width*1.4,3+speedRatio*8);ctx.restore();ctx.strokeStyle="rgba(141,211,255,.22)";ctx.lineWidth=2;ctx.setLineDash([3,6]);ctx.beginPath();ctx.moveTo(-width*.55,-height*.1);ctx.lineTo(-width*.55,-height*.1-22-speedRatio*22);ctx.stroke();ctx.setLineDash([])}ctx.globalAlpha=.16;ctx.fillStyle="#000";ctx.fillRect(-width*.42,height*.34,width*.84,5);ctx.globalAlpha=1;ctx.scale(stretch,squash);if(this.playerImageLoaded){const drawW=Math.max(width*1.58,54),ratio=this.playerImage.naturalHeight/Math.max(1,this.playerImage.naturalWidth),drawH=drawW*ratio;ctx.imageSmoothingEnabled=false;ctx.drawImage(this.playerImage,-drawW/2,-drawH/2-4,drawW,drawH)}else this._drawFallbackPlayer(width*1.28,height*1.28);if(hasWater){const bucketColor=cosmeticColor||PALETTE.bucketFallback,bx=width*.34,by=-7,bw=21,bh=this.bucketImageLoaded?bw*(this.bucketImage.naturalHeight/Math.max(1,this.bucketImage.naturalWidth)):18;if(this.bucketImageLoaded){ctx.imageSmoothingEnabled=false;ctx.drawImage(this.bucketImage,bx,by,bw,bh)}else{ctx.fillStyle=bucketColor;ctx.fillRect(bx,by+1,bw-2,13);ctx.fillStyle=PALETTE.water;ctx.fillRect(bx+4,by+2,10,6);ctx.strokeStyle="#555";ctx.lineWidth=2;ctx.strokeRect(bx+3,by-3,10,5)}}ctx.restore();this._drawLandingFx()}
  _drawFallbackPlayer(width,height){const ctx=this.ctx;ctx.fillStyle="#3b9d2b";ctx.fillRect(-width/2,-height/2,width,height*.68);ctx.fillStyle="#e8c79a";ctx.fillRect(-width/2+4,-height/2-12,width-8,14);ctx.fillStyle="#2b2b26";ctx.fillRect(-width/2+3,height*.18,width*.35,height*.16);ctx.fillRect(width/2-width*.35-3,height*.18,width*.35,height*.16)}
  _drawLandingFx(){const ctx=this.ctx;for(const fx of this.landingFx){const t=fx.age/fx.life,e=1-Math.pow(1-t,3);ctx.save();ctx.globalAlpha=(1-t)*.8;ctx.strokeStyle=PALETTE.impact;ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(fx.x,fx.y-2,8+e*34*fx.power,3+e*11,0,0,Math.PI*2);ctx.stroke();ctx.globalAlpha=(1-t)*.42;ctx.fillStyle=PALETTE.impact;const burst=12+e*34*fx.power;for(let i=0;i<8;i++){const a=Math.PI*2/8*i;ctx.fillRect(fx.x+Math.cos(a)*burst-2,fx.y-3+Math.sin(a)*burst*.23-2,4,4)}ctx.restore()}}
  drawGhost(x,y,width,height){const ctx=this.ctx;ctx.save();ctx.globalAlpha=.5;ctx.fillStyle=PALETTE.ghost;ctx.fillRect(x-width/2,y-height/2,width,height*.68);ctx.restore()}
  drawTrajectoryGuide(startX,startY,groundY){const ctx=this.ctx;ctx.save();ctx.strokeStyle="rgba(255,216,74,.5)";ctx.setLineDash([4,4]);ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(startX,startY);ctx.lineTo(startX,groundY);ctx.stroke();ctx.restore()}
}
